<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BlogScape | Feed</title>
    <link rel="stylesheet" href="/Posts/Posts.css">
    <style>
        /* ==========================================================================
           Layout Scroll & Responsive Fixes (Preserving your exact original design)
           ========================================================================== */
        
        /* Freeze the main viewport so the screen doesn't scroll */
        html, body {
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
            box-sizing: border-box;
        }

        /* Full layout wrapper to structure the fixed header + scrollable body */
        .app-layout {
            display: flex;
            flex-direction: column;
            height: 100vh;
            width: 100vw;
        }

        header {
            position: relative;
            flex-shrink: 0; /* Prevents the header from compressing */
            box-sizing: border-box;
        }

        /* Grid container takes up remaining space and stays fixed */
        .container {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 32px;
            max-width: 1140px;
            margin: 0 auto;
            padding: 20px;
            width: 100%;
            height: calc(100vh - 76px); /* Subtracts header height */
            box-sizing: border-box;
            overflow: hidden;
        }

        /* The core feed column layout housing the post box */
        .feed-section {
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }

        .section-title {
            flex-shrink: 0;
            margin-top: 0;
        }

        /* The posts box handles all the scrolling natively */
        #postsContainer {
            flex: 1;
            overflow-y: auto; /* Enables internal scrolling for posts */
            -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS/Mobile devices */
            box-sizing: border-box;
        }

        /* Hides the scrollbar completely on Chrome, Safari, and Opera while keeping scrolling */
        #postsContainer::-webkit-scrollbar {
            display: none;
        }

        /* Hides the scrollbar completely on IE, Edge, and Firefox while keeping scrolling */
        #postsContainer {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }

        /* Keep sidebar contents visible or independently scrollable if large */
        .sidebar {
            height: 100%;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        
        .sidebar::-webkit-scrollbar {
            display: none;
        }
        .sidebar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Hidden Checkbox for Mobile Navigation */
        #menu-toggle {
            display: none !important;
        }

        /* Hamburger Graphic Layout setup */
        .menu-icon {
            display: none;
            cursor: pointer;
            padding: 10px;
            z-index: 110;
        }

        .menu-icon span {
            display: block;
            width: 24px;
            height: 2px;
            background-color: currentColor; /* Safely inherits your theme text color */
            margin: 5px 0;
            transition: transform 0.3s ease, opacity 0.3s ease;
            border-radius: 2px;
        }

        /* ==========================================================================
           Media Queries for Tablet & Mobile Layout Shifts
           ========================================================================== */
        @media (max-width: 960px) {
            html, body {
                overflow: hidden; /* Keep body fixed even on tablet/mobile screens */
            }
            .container {
                grid-template-columns: 1fr;
                overflow-y: auto; /* Allow layout wrapper container to scroll natively when components stack */
                -webkit-overflow-scrolling: touch;
                height: calc(100vh - 76px);
            }
            .container::-webkit-scrollbar {
                display: none;
            }
            .container {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            #postsContainer {
                overflow-y: visible; /* Let the post elements unfold naturally inside the scrollable container layout */
                height: auto;
                flex: none;
            }
            .sidebar {
                order: 2;
                height: auto;
                overflow-y: visible;
                margin-top: 20px;
            }
            .feed-section {
                order: 1;
                height: auto;
                overflow-y: visible;
            }
        }

        @media (max-width: 768px) {
            header {
                padding: 0 20px !important;
            }

            .menu-icon {
                display: block; /* Hamburger becomes visible */
            }

            /* Shift Navigation panel into a drop-down layout */
            nav {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: inherit; /* Matches your header background naturally */
                border-bottom: 1px solid rgba(0, 0, 0, 0.1);
                flex-direction: column;
                align-items: stretch !important;
                gap: 0 !important;
                padding: 10px 20px 20px 20px;
                box-shadow: 0 10px 15px rgba(0, 0, 0, 0.05);
                
                pointer-events: none;
                opacity: 0;
                transform: translateY(-10px);
                transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
                z-index: 105;
            }

            nav a {
                display: block;
                width: 100%;
                text-align: center;
                padding: 14px 0;
                box-sizing: border-box;
                opacity: 0;
                transform: translateY(-8px);
                transition: transform 0.3s ease, opacity 0.3s ease;
            }

            nav a.btn-posts {
                margin-top: 10px;
            }

            /* Dropdown toggle display action rules */
            #menu-toggle:checked ~ nav {
                opacity: 1;
                transform: translateY(0);
                pointer-events: auto;
            }

            #menu-toggle:checked ~ nav a:nth-child(1) { opacity: 1; transform: translateY(0); transition-delay: 0.04s; }
            #menu-toggle:checked ~ nav a:nth-child(2) { opacity: 1; transform: translateY(0); transition-delay: 0.09s; }
            #menu-toggle:checked ~ nav a:nth-child(3) { opacity: 1; transform: translateY(0); transition-delay: 0.14s; }

            /* Hamburger icon transforms into 'X' symbol overlay when active */
            #menu-toggle:checked ~ .menu-icon span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
            #menu-toggle:checked ~ .menu-icon span:nth-child(2) { opacity: 0; }
            #menu-toggle:checked ~ .menu-icon span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

            .modal-content {
                width: 92% !important;
                margin: 20px auto !important;
                padding: 16px !important;
            }
        }
    </style>
</head>
<body data-current-user="<%= user ? user.username : '' %>">
    <div class="app-layout">
        <header>
            <a href="/" class="logo-container">
                <div class="logo-box">B</div>
                <span class="logo-text">BlogScape</span>
            </a>

            <!-- Responsive Mobile Menu Control Nodes -->
            <input type="checkbox" id="menu-toggle">
            <label for="menu-toggle" class="menu-icon">
                <span></span>
                <span></span>
                <span></span>
            </label>

            <nav>
                <a href="/Posts" class="nav-link">Posts</a>
                <a href="/Blog" class="btn-posts">Profile</a>
                <a href="/Posts/<%= user ? user.username : '' %>/MyPosts" class="btn-posts">My Posts</a>
            </nav>
        </header>

        <div class="container">
            <main class="feed-section">
                <h1 class="section-title">Latest Stories</h1>
                <div id="postsContainer">
                    <% for(let post of posts) { %>
                        <% if (post.user != null) { %>
                        <div class="post-card" data-post-id="<%= post.title %>">
                            <div class="post-header">
                                <div class="user-info">
                                    <div class="avatar"><%= post.initial %></div>
                                    <div class="user-details">
                                        <h4><%= post.user %></h4>
                                    </div>
                                </div>
                                <span class="topic-badge"><%= post.topic %></span>
                            </div>
                            <div class="post-content">
                                <h2><%= post.title %></h2>
                                <p><%= post.content %></p>
                            </div>
                            <div class="post-footer">
                                <div class="stat-item like-btn" data-liked="false">
                                    <svg class="heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                    </svg>
                                    <span class="like-count"><%= post.likes %></span>
                                </div>
                                <div class="stat-item comment-trigger">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                                    </svg>
                                    <span class="comment-count"><%= post.comments %></span>
                                </div>
                            </div>
                        </div>
                        <% } %>   
                    <% } %>
                </div>
            </main>

            <aside class="sidebar">
                <div class="widget-card">
                    <h3 class="widget-title">Popular Topics</h3>
                    <ul class="topic-list">
                        <% for(let topic of topics) { %>
                            <li class="topic-item">
                                <span class="topic-name"><%= topic.name %></span>
                                <span class="topic-count"><%= topic.count %></span>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </aside>

            <!-- Lightbox Overlay Modals Setup Blocks -->
            <div id="commentModal" class="modal">
                <div class="modal-content">
                    <span class="close-modal">&times;</span>
                    <h3 id="modalTitle">Comments</h3>
                    <div id="commentsList"></div>
                    <div class="comment-input-area">
                        <input type="text" id="newCommentInput" placeholder="Add a comment...">
                        <button id="submitComment">Post</button>
                    </div>
                </div>
            </div>

            <div id="postViewModal" class="modal">
                <div class="modal-content post-view-content">
                    <div class="view-header">
                        <div class="user-info">
                            <div class="avatar" id="viewAvatar"></div>
                            <div class="user-details">
                                <h4 id="viewUser"></h4>
                            </div>
                        </div>
                        <span class="topic-badge" id="viewTopic"></span>
                    </div>
                    <div class="full-content-scrollable">
                        <h1 id="viewTitle"></h1>
                        <p id="viewFullText"></p>
                    </div>
                    <div class="post-footer" id="viewFooter">
                    </div>
                    <div class="close">
                        <button class="close-view-modal">Close Post</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/Posts/Posts.js"></script>
</body>
</html>