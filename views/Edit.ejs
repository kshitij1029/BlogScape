<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EditPosts</title>
    <link rel="stylesheet" href="/Blog/Blog.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <style>
        /* ==========================================================================
           MOBILE RESPONSIVENESS & BUG FIXES (Leaves Laptop Layout Intact)
           ========================================================================== */
        
        /* Base helper to ensure hamburger button defaults to hidden on desktop */
        .menu-toggle {
            display: none;
            background: none;
            border: none;
            color: inherit;
            font-size: 24px;
            cursor: pointer;
        }

        @media screen and (max-width: 768px) {
            /* 1. Header Layout Adjustments */
            header {
                position: relative;
                display: flex !important;
                flex-direction: column;
                align-items: stretch !important;
                justify-content: flex-start !important;
                padding: 15px 20px;
                background-color: #fff; 
                box-shadow: 0 2px 5px rgba(0,0,0,0.05);
                z-index: 100; 
            }

            .nav-container {
                display: flex !important;
                justify-content: space-between !important;
                align-items: center !important;
                width: 100%;
            }

            .menu-toggle {
                display: block; /* Shows hamburger icon on mobile */
            }

            /* 2. Responsive Menu: Stacks elements downward to prevent overlapping content */
            .nav-links {
                display: none; /* Hidden by default */
                flex-direction: column;
                width: 100%;
                gap: 12px;
                padding: 15px 0 5px 0;
                text-align: center;
            }

            /* Class injected by JavaScript when hamburger is clicked */
            .nav-links.show {
                display: flex !important;
            }

            /* 3. Perfect Centering and Bound Alignment for Links & Buttons */
            .nav-links a {
                display: flex !important;
                justify-content: center !important;
                align-items: center !important;
                width: 100%;
                text-align: center;
                padding: 8px 0;
            }

            /* Keeps the "Posts" button perfectly structured on small screens */
            .nav-links button.btn-primary {
                width: 100%;
                height: 45px;
                display: flex !important;
                justify-content: center !important;
                align-items: center !important;
                border-radius: 25px; 
                padding: 0;
                overflow: hidden;
            }

            .nav-links button.btn-primary a {
                width: 100%;
                height: 100%;
                display: flex !important;
                justify-content: center !important;
                align-items: center !important;
                color: white !important;
            }

            /* 4. Page layout shift down */
            .container {
                display: flex;
                flex-direction: column;
                gap: 30px;
                padding: 20px 15px;
                margin-top: 0; 
            }

            main, aside {
                width: 100% !important;
            }

            main form + form {
                margin-top: 15px;
            }

            /* 5. Perfect Text Centering across Div Blocks */
            .logo,
            .logo-icon,
            .user-stat-card,
            .post-tag,
            .sidebar-widget h3 {
                display: flex !important;
                justify-content: center !important;
                align-items: center !important;
                text-align: center !important;
            }

            .sidebar-widget {
                text-align: center;
            }

            .user-stat-card {
                flex-direction: column;
                gap: 10px;
            }

            /* Catches category flex container on mobile */
            .sidebar-widget div[style*="display: flex"] {
                justify-content: center !important;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="nav-container">
            <a href="#" class="logo">
                <div class="logo-icon">B</div>
                <div class="logo-text">BlogScape</div>
            </a>
            <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
        
        <div class="nav-links" id="navLinks">
            <a href="/Blog" class="active">Profile</a>
            <button class="btn-primary">
                <a href="/Posts" style="color:white; display: flex; align-items: center; justify-content: center; height: 100%; width: 100%;">Posts</a>
            </button>
        </div>
    </header>

    <div class="container">
        <main>
            <form id="loginForm" method="POST" action="/Posts/<%= post.id %>?_method=PATCH">
                <input type="hidden" id="post-id">
                <div class="form-group">
                    <label>Story Title</label>
                    <input type="text" name="title" id="post-title" placeholder="Enter a catchy title..." required value="<%= post.title %>">
                </div>
                <div class="form-group">
                    <label>Topic </label>
                    <input type="text" id="post-topic" name="topic" placeholder="E.g. Technology" required value="<%= post.topic %>">
                </div>
                <div class="form-group">
                    <label>Content</label>
                    <textarea id="post-content" name="content" placeholder="Tell your story..." required><%= post.content %></textarea>
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; height: 50px; font-size: 16px;">Update Story</button>
            </form>
            <form method="post" action="/Posts/<%= post.id %>?_method=DELETE" >
                <button type="submit" class="trash btn-primary">
                    Delete Story <i class="fa-solid fa-trash" style="font-size: 16px; color:white"></i>
                </button>
            </form> 
        </main>

        <aside>
            <div class="sidebar-widget">
                <h3>About BlogScape</h3>
                <p style="font-size: 14px; color: var(--text-secondary);">
                    A space where your words matter. Join our community of writers and share your unique perspective with the world.
                </p>
            </div>
            <% let blogger = user ? user.username : "Guest" %>
            <div class="sidebar-widget">
                <h3>Current Writer</h3>
                <div id="current-user-info" class="user-stat-card">
                    <div class="user-avatar"><%= blogger.charAt(0).toUpperCase() %></div>
                    <div>
                        <span class="user-name" id="display-uid"><%= blogger %></span>
                        <span class="post-date">Blog Contributor</span>
                    </div>
                </div>
            </div>

            <div class="sidebar-widget">
                <h3>Top Categories to WriteOn</h3>
                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px;">
                    <span class="post-tag">Lifestyle</span>
                    <span class="post-tag">Technology</span>
                    <span class="post-tag">Business</span>
                    <span class="post-tag">Art</span>
                    <span class="post-tag">Culture</span>
                </div>
            </div>
        </aside>
    </div>

    <div id="toast">Post published successfully!</div>

    <script src="/Blog/Blog.js"></script>
    
    <script>
        const menuToggle = document.getElementById('menuToggle');
        const navLinks = document.getElementById('navLinks');

        menuToggle.addEventListener('click', () => {
            navLinks.classList.toggle('show');
            const icon = menuToggle.querySelector('i');
            // Dynamically alternates between Hamburger (bars) and Close (xmark) icons
            icon.classList.toggle('fa-bars');
            icon.classList.toggle('fa-xmark');
        });
    </script>
</body>
</html>