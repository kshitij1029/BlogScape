<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EditPosts</title>
    <link rel="stylesheet" href="/Blog/Blog.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        /* ==========================================================================
           Mobile Responsive Enhancements (Desktop View Remains Intact)
           ========================================================================== */

        /* Core Layout Alignment Rules */
        .container {
            display: flex;
            gap: 32px;
            max-width: 1140px;
            margin: 0 auto;
            padding: 20px;
            box-sizing: border-box;
        }

        main {
            flex: 1;
        }

        aside {
            width: 340px;
            flex-shrink: 0;
        }

        /* Hidden Control Nodes for Mobile Nav Burger */
        #menu-toggle {
            display: none !important;
        }

        .menu-icon {
            display: none;
            cursor: pointer;
            padding: 10px;
            z-index: 110;
        }

        .menu-icon span {
            display: block;
            width: 24px;
            height: 2px;
            background-color: currentColor;
            margin: 5px 0;
            transition: transform 0.3s ease, opacity 0.3s ease;
            border-radius: 2px;
        }

        /* Responsive Breakpoint Matrix */
        @media (max-width: 768px) {
            header {
                position: relative;
                padding: 0 20px !important;
                display: flex;
                justify-content: space-between;
                align-items: center;
                height: 70px;
                box-sizing: border-box;
            }

            /* Enable the Interactive Hamburger Graphics */
            .menu-icon {
                display: block;
            }

            /* Shift Navigation panel into an animated dropdown drawer */
            .nav-links {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: white; /* Fallback profile default background */
                border-bottom: 1px solid rgba(0, 0, 0, 0.1);
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 0 !important;
                padding: 10px 20px 20px 20px;
                box-shadow: 0 10px 15px rgba(0, 0, 0, 0.05);
                
                pointer-events: none;
                opacity: 0;
                transform: translateY(-10px);
                transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
                z-index: 105;
                display: flex;
            }

            .nav-links a, 
            .nav-links button {
                width: 100%;
                box-sizing: border-box;
                text-align: center;
            }

            .nav-links a {
                padding: 14px 0;
                display: block;
            }

            .nav-links button {
                margin-top: 10px;
                height: 45px;
            }

            /* Toggle Action Triggers */
            #menu-toggle:checked ~ .nav-links {
                opacity: 1;
                transform: translateY(0);
                pointer-events: auto;
            }

            /* Morph Hamburger to standard Close (X) format */
            #menu-toggle:checked ~ .menu-icon span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
            #menu-toggle:checked ~ .menu-icon span:nth-child(2) { opacity: 0; }
            #menu-toggle:checked ~ .menu-icon span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

            /* Structural Layout Collapsing */
            .container {
                flex-direction: column;
                gap: 24px;
                padding: 16px;
            }

            aside {
                width: 100%;
                order: 2; /* Form retains top visibility position */
            }

            main {
                order: 1;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="nav-container">
            <a href="#" class="logo">
                <div class="logo-icon">B</div>
                <div class="logo-text">BlogScape</div>
            </a>
            <!-- Hamburger Menu Icon (Hidden on desktop) -->
            <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
        <!-- Grouped links for mobile toggle behavior -->
        <div class="nav-links" id="navLinks">
            <a href="/Blog" class="active">Profile</a>
            <button class="btn-primary"><a href="/Posts" style="color:white; display: flex; align-items: center; justify-content: center; height: 100%; width: 100%;">Posts</a></button>
        </div>
    </header>

    <div class="container">
        <!-- Main Feed Area -->
        <main>
            <form id="loginForm" method="POST" action="/Posts/<%= post.id %>?_method=PATCH">
                <input type="hidden" id="post-id">
                <div class="form-group">
                    <label>Story Title</label>
                    <input type="text" name="title" id="post-title" placeholder="Enter a catchy title..." required value="<%= post.title %>">
                </div>
                <div class="form-group">
                    <label>Topic </label>
                    <input type="text" id="post-topic" name="topic" placeholder="E.g. Technology" required value="<%= post.topic %>">
                </div>
                <div class="form-group">
                    <label>Content</label>
                    <textarea id="post-content" name="content" placeholder="Tell your story..." required><%= post.content %></textarea>
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; height: 50px; font-size: 16px;">Update Story</button>
                   
            </form>
            <form method="post" action="/Posts/<%= post.id %>?_method=DELETE" >
                <button type="submit" class="trash btn-primary">
                    Delete Story <i class="fa-solid fa-trash" style="font-size: 16px; color:white"></i>
                </button>
            </form> 
        </main>

        <!-- Sidebar -->
        <aside>
            <div class="sidebar-widget">
                <h3>About BlogScape</h3>
                <p style="font-size: 14px; color: var(--text-secondary);">
                    A space where your words matter. Join our community of writers and share your unique perspective with the world.
                </p>
            </div>
            <% let blogger = user ? user.username : "Guest" %>
            <div class="sidebar-widget">
                <h3>Current Writer</h3>
                <div id="current-user-info" class="user-stat-card">
                    <!-- User info will be injected here -->
                    <div class="user-avatar"><%= blogger.charAt(0).toUpperCase() %></div>
                    <div>
                        <span class="user-name" id="display-uid"><%= blogger %></span>
                        <span class="post-date">Blog Contributor</span>
                    </div>
                </div>
            </div>

            <div class="sidebar-widget">
                <h3>Top Categories to WriteOn</h3>
                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px;">
                    <span class="post-tag">Lifestyle</span>
                    <span class="post-tag">Technology</span>
                    <span class="post-tag">Business</span>
                    <span class="post-tag">Art</span>
                    <span class="post-tag">Culture</span>
                </div>
            </div>
        </aside>
    </div>

    <div id="toast">Post published successfully!</div>

    <script src="/Blog/Blog.js"></script>
</body>
</html>