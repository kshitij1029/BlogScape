<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Posts</title>

    <link rel="stylesheet" href="/MyPosts/MyPosts.css">

</head>

<body data-current-user="<%= user ? user.username : '' %>">

    <header>

        <a href="#" class="logo-container">

            <div class="logo-box">B</div>

            <div class="logo-text">BlogScape</div>

        </a>

        <nav>

            <a href="/Blog" class="nav-link">Profile</a>

            <a href="/Posts" class="btn-orange">Posts</a>

            <a href="/Posts/<%= user ? user.username : '' %>/MyPosts" class="btn-orange">My Posts</a>

        </nav>

    </header>



    <main class="main-container">

        <section id="my-posts-feed">

            <h1 class="section-title">My Published Posts</h1>

            <div id="posts-container">

                <% for(let post of posts) { %>

                    <% if (post.user === user.username) { %>

                    <article class="post-card" data-post-id="<%= post.title %>">

                        <div class="post-header">

                            <div class="author-info">

                                <div class="avatar"><%= post.initial %></div>

                                <span class="author-name"><%= post.user %></span>

                            </div>

                            <span class="category-tag"><%= post.topic %></span>

                        </div>

                       

                        <h2 class="post-title"><%= post.title %></h2>

                        <p class="post-excerpt"><%= post.content %></p>

                       

                        <div class="post-footer">

                            <div class="stat-item like-btn" data-liked="false">

                                <svg class="heart-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">

                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>

                                </svg>

                                <span class="like-count"><%= post.likes %></span> Likes

                            </div>



                            <div class="stat-item comment-trigger">

                                <svg class="icon" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>

                                <span class="comment-count"><%= post.comments %></span> Comments

                            </div>



                            <% if(user && user.username === post.user) { %>

                            <a href="/Posts/<%= post.id %>/edit" class="update-btn" style="text-decoration: none; color: white;">Update</a>

                            <% } %>

                        </div>

                    </article>

                    <% } %>

                <% } %>

               

                <% if (posts.filter(p => p.user === user.username).length === 0) { %>

                    <div class="NoPosts">

                        <p>You haven't published any posts yet.</p>

                    </div>

                <% } %>

            </div>

        </section>

    </main>



    <div id="commentModal" class="modal">

        <div class="modal-content">

            <span class="close-modal">&times;</span>

            <h3 id="modalTitle">Comments</h3>

            <div id="commentsList"></div>

            <div class="comment-input-area">

                <input type="text" id="newCommentInput" placeholder="Write a comment...">

                <button id="submitComment">Post</button>

            </div>

        </div>

    </div>



    <script src="/MyPosts/MyPosts.js"></script>

</body>

</html>